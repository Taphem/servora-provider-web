# The public Servora API Gateway origin. The browser talks ONLY to this —
# never directly to servora-provider, servora-services, or any other
# downstream service. See src/lib/env.ts.
NEXT_PUBLIC_API_BASE_URL=https://api.servora.hemandu.com

# The primary Servora site origin, used for absolute links back to the
# customer app (e.g. "sign in" sends the user to the main site, since this
# app never implements its own login).
NEXT_PUBLIC_SITE_URL=https://servora.hemandu.com

# Path this app is mounted under once served behind servora-web's rewrite
# (https://servora.hemandu.com/provider). Leave unset for local dev, where
# this app runs standalone at "/" on its own port.
NEXT_PUBLIC_BASE_PATH=/provider
